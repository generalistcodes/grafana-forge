#!/usr/bin/env bash
set -Eeuo pipefail

APP="grafana-forge"
VERSION="0.3.0"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$ROOT/.state"
ENV_FILE="$ROOT/.env"
COMPOSE_FILE="$ROOT/compose.yml"
mkdir -p "$STATE_DIR"

# Reuse the generated credentials on subsequent runs so the persisted Grafana
# volume and the printed login details never drift apart.
if [[ -f "$ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$ENV_FILE"
fi
: "${GRAFANA_ADMIN_USER:=admin}"
if [[ -z "${GRAFANA_ADMIN_PASSWORD:-}" ]]; then
  GRAFANA_ADMIN_PASSWORD="forge-$(printf %s "$ROOT" | sha256sum | cut -c1-16)"
fi
: "${FORGE_GRAFANA_PLUGINS:=}"
: "${FORGE_RETENTION:=15d}"
: "${FORGE_LOG_RETENTION:=168h}"
: "${FORGE_SCRAPE_INTERVAL:=15s}"
: "${FORGE_DASHBOARD_REFRESH:=30s}"

log(){ printf '[%s] %s\n' "$APP" "$*"; }
err(){ printf '[%s] ERROR: %s\n' "$APP" "$*" >&2; }
usage(){
  cat <<USAGE
Grafana Forge $VERSION

One-command, self-configuring observability stack and developer Swiss Army knife.

Usage:
  ./grafana-forge                         Auto-detect and start everything
  ./grafana-forge up [host] [docker] [logs]
  ./grafana-forge status
  ./grafana-forge urls
  ./grafana-forge doctor
  ./grafana-forge debug [--json]
  ./grafana-forge config
  ./grafana-forge repair [service]
  ./grafana-forge logs [service]
  ./grafana-forge backup
  ./grafana-forge down
  ./grafana-forge reset

Profiles:
  host      Linux CPU, RAM, swap, filesystem, disk I/O, network, load
  docker    Docker CPU, RAM, filesystem, network and container lifecycle
  logs      Docker logs through Alloy -> Loki

Environment:
  FORGE_GRAFANA_PLUGINS       Grafana plugin list
  FORGE_RETENTION              Prometheus retention, default 15d
  FORGE_LOG_RETENTION          Loki retention, default 168h
  FORGE_SCRAPE_INTERVAL       Prometheus scrape interval, default 15s
  FORGE_DASHBOARD_REFRESH     Dashboard refresh interval, default 30s
  GRAFANA_ADMIN_USER          Grafana admin username
  GRAFANA_ADMIN_PASSWORD      Grafana admin password

Examples:
  ./grafana-forge
  ./grafana-forge up host docker logs
  FORGE_GRAFANA_PLUGINS=grafana-clock-panel ./grafana-forge
  ./grafana-forge doctor
USAGE
}

need(){ command -v "$1" >/dev/null 2>&1 || { err "Missing dependency: $1"; exit 1; }; }

port_free(){
  local p="$1"
  if command -v ss >/dev/null 2>&1; then
    ! ss -lntH 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$p$"
  elif command -v lsof >/dev/null 2>&1; then
    ! lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1
  else
    return 0
  fi
}

pick_port(){
  local p="$1"
  while ! port_free "$p"; do p=$((p+1)); done
  printf '%s' "$p"
}

write_env(){
  cat > "$ENV_FILE" <<EOF_ENV
# Generated by grafana-forge. Safe to edit after generation.
GRAFANA_PORT=${GRAFANA_PORT}
PROMETHEUS_PORT=${PROMETHEUS_PORT}
LOKI_PORT=${LOKI_PORT}
GRAFANA_ADMIN_USER=${GRAFANA_ADMIN_USER}
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER}
GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
FORGE_GRAFANA_PLUGINS=${FORGE_GRAFANA_PLUGINS}
FORGE_RETENTION=${FORGE_RETENTION}
FORGE_LOG_RETENTION=${FORGE_LOG_RETENTION}
FORGE_SCRAPE_INTERVAL=${FORGE_SCRAPE_INTERVAL}
FORGE_DASHBOARD_REFRESH=${FORGE_DASHBOARD_REFRESH}
EOF_ENV
}

has_profile(){ printf '%s\n' "${PROFILES[*]}" | grep -qw -- "$1"; }

parse_profiles(){
  PROFILES=()
  if [[ $# -eq 0 ]]; then
    PROFILES=(host)
    if docker info >/dev/null 2>&1; then PROFILES+=(docker logs); fi
    return
  fi
  for p in "$@"; do
    case "$p" in host|docker|logs) PROFILES+=("$p");; *) err "Unknown profile: $p"; usage; exit 2;; esac
  done
  if has_profile host && [[ "$(uname -s)" != "Linux" ]]; then
    err "The host profile currently targets Linux. Use 'docker' and/or 'logs' on macOS/Windows."; exit 2
  fi
}

render(){
  mkdir -p "$ROOT/provisioning/datasources" "$ROOT/provisioning/dashboards" "$ROOT/dashboards" "$ROOT/config" "$ROOT/alerts"
  GRAFANA_PORT="${GRAFANA_PORT:-$(pick_port 3000)}"
  PROMETHEUS_PORT="${PROMETHEUS_PORT:-$(pick_port 9090)}"
  LOKI_PORT="${LOKI_PORT:-$(pick_port 3100)}"
  write_env
  printf "%s\n" "${PROFILES[*]}" > "$STATE_DIR/profiles"

  local host_services="" node_exporter="" docker_services="" cadvisor="" logs_services="" alloy="" loki_service="" loki_volume=""
  if has_profile host; then
    node_exporter=$(cat <<'EOF_SVC'
  node-exporter:
    image: prom/node-exporter:v1.9.1
    restart: unless-stopped
    pid: host
    command:
      - --path.rootfs=/host
    volumes:
      - /:/host:ro,rslave
EOF_SVC
)
  fi

  if has_profile docker; then
    cadvisor=$(cat <<'EOF_SVC'
  cadvisor:
    image: ghcr.io/google/cadvisor:v0.53.0
    restart: unless-stopped
    privileged: true
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
EOF_SVC
)
  fi

  if has_profile logs; then
    loki_service=$(cat <<'EOF_SVC'
  loki:
    image: grafana/loki:3.5.3
    restart: unless-stopped
    ports:
      - "${LOKI_PORT}:3100"
    command: -config.file=/etc/loki/config.yml
    volumes:
      - ./loki-config.yml:/etc/loki/config.yml:ro
      - loki-data:/loki
EOF_SVC
)
    loki_volume='  loki-data:'
    alloy=$(cat <<'EOF_SVC'
  alloy:
    image: grafana/alloy:v1.10.2
    restart: unless-stopped
    command:
      - run
      - /etc/alloy/config.alloy
      - --server.http.listen-addr=0.0.0.0:12345
      - --disable-reporting
    volumes:
      - ./config/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
EOF_SVC
)
  fi

  cat > "$COMPOSE_FILE" <<EOF_COMPOSE
services:
  grafana:
    image: grafana/grafana:12.1.1
    restart: unless-stopped
    ports:
      - "${GRAFANA_PORT}:3000"
    env_file:
      - ./.env
    environment:
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_INSTALL_PLUGINS: "${FORGE_GRAFANA_PLUGINS}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:3000/api/health >/dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
    volumes:
      - grafana-data:/var/lib/grafana
      - ./provisioning:/etc/grafana/provisioning:ro
      - ./dashboards:/var/lib/grafana/dashboards:ro

  prometheus:
    image: prom/prometheus:v3.5.0
    restart: unless-stopped
    ports:
      - "${PROMETHEUS_PORT}:9090"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --web.enable-lifecycle
      - --storage.tsdb.retention.time=${FORGE_RETENTION}
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O- http://127.0.0.1:9090/-/ready >/dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./alerts:/etc/prometheus/alerts:ro
      - prometheus-data:/prometheus
${node_exporter}
${cadvisor}
${alloy}
${loki_service}

volumes:
  grafana-data:
  prometheus-data:
${loki_volume}
EOF_COMPOSE

  cat > "$ROOT/prometheus.yml" <<'EOF_PROM'
global:
  scrape_interval: ${FORGE_SCRAPE_INTERVAL}
  evaluation_interval: ${FORGE_SCRAPE_INTERVAL}
rule_files:
  - /etc/prometheus/alerts/*.yml
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['prometheus:9090']
EOF_PROM
  if has_profile host; then cat >> "$ROOT/prometheus.yml" <<'EOF_PROM'
  - job_name: node
    static_configs:
      - targets: ['node-exporter:9100']
EOF_PROM
  fi
  if has_profile docker; then cat >> "$ROOT/prometheus.yml" <<'EOF_PROM'
  - job_name: cadvisor
    static_configs:
      - targets: ['cadvisor:8080']
EOF_PROM
  fi

  cat > "$ROOT/loki-config.yml" <<'EOF_LOKI'
auth_enabled: false
server:
  http_listen_port: 3100
common:
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h
limits_config:
  allow_structured_metadata: true
  volume_enabled: true
  retention_period: ${FORGE_LOG_RETENTION}
compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem
EOF_LOKI

  cat > "$ROOT/config/config.alloy" <<'EOF_ALLOY'
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label = "stream"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
EOF_ALLOY

  cat > "$ROOT/provisioning/datasources/datasources.yml" <<EOF_DS
apiVersion: 1
datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false
EOF_DS
  if has_profile logs; then cat >> "$ROOT/provisioning/datasources/datasources.yml" <<'EOF_DS'
  - name: Loki
    uid: loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false
EOF_DS
  fi

  cat > "$ROOT/provisioning/dashboards/dashboards.yml" <<'EOF_DASH'
apiVersion: 1
providers:
  - name: grafana-forge
    orgId: 1
    folder: Grafana Forge
    type: file
    disableDeletion: false
    editable: false
    options:
      path: /var/lib/grafana/dashboards
EOF_DASH

  rm -f "$ROOT/dashboards"/*.json
  cp "$ROOT/templates/dashboards/forge-home.json" "$ROOT/dashboards/forge-home.json"
  if has_profile host; then cp "$ROOT/templates/dashboards/forge-server.json" "$ROOT/dashboards/forge-server.json"; fi
  if has_profile docker; then cp "$ROOT/templates/dashboards/forge-docker.json" "$ROOT/dashboards/forge-docker.json"; fi
  if has_profile logs; then cp "$ROOT/templates/dashboards/forge-logs.json" "$ROOT/dashboards/forge-logs.json"; fi
  cp "$ROOT/templates/alerts/forge.yml" "$ROOT/alerts/forge.yml"
}

compose_config(){ docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" config >/dev/null; }
wait_http(){ local url="$1" tries="${2:-30}"; for ((i=1;i<=tries;i++)); do curl -fsS --max-time 2 "$url" >/dev/null 2>&1 && return 0; sleep 2; done; return 1; }
check_targets(){
  local json
  json="$(curl -fsS --max-time 5 "http://127.0.0.1:${PROMETHEUS_PORT}/api/v1/targets" 2>/dev/null || true)"
  [[ -n "$json" ]] || return 1
  command -v python3 >/dev/null 2>&1 || return 0
  printf '%s' "$json" | python3 -c 'import json,sys; d=json.load(sys.stdin); xs=d.get("data",{}).get("activeTargets",[]); print("\n".join(f"{x.get("labels",{}).get("job","?")}: {x.get("health","?")}" for x in xs)); raise SystemExit(1 if (not xs or any(x.get("health")!="up" for x in xs)) else 0)'
}
check_grafana_dashboards(){
  command -v curl >/dev/null 2>&1 || return 0
  local failed=0 uid
  for uid in forge-home forge-server forge-docker forge-logs; do
    [[ -f "$ROOT/dashboards/$uid.json" ]] || continue
    if curl -fsS --max-time 5 -u "${GRAFANA_ADMIN_USER}:${GRAFANA_ADMIN_PASSWORD}" "http://127.0.0.1:${GRAFANA_PORT}/api/dashboards/uid/$uid" >/dev/null 2>&1; then
      printf '[PASS] dashboard %-17s\n' "$uid"
    else
      printf '[FAIL] dashboard %-17s\n' "$uid"; failed=1
    fi
  done
  return "$failed"
}
up(){
  need docker
  docker compose version >/dev/null 2>&1 || { err "Docker Compose v2 is required."; exit 1; }
  parse_profiles "$@"
  render
  log "Profiles: ${PROFILES[*]}"
  log "Ports: Grafana=$GRAFANA_PORT Prometheus=$PROMETHEUS_PORT Loki=$LOKI_PORT"
  log "Validating generated configuration..."
  compose_config || { err "Generated Compose configuration is invalid."; exit 1; }
  docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" pull
  docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d
  if command -v curl >/dev/null 2>&1; then
    wait_http "http://127.0.0.1:${PROMETHEUS_PORT}/-/ready" 30 || warn "Prometheus is not ready yet."
    wait_http "http://127.0.0.1:${GRAFANA_PORT}/api/health" 30 || warn "Grafana is not ready yet."
  fi
  log "Stack started. Run './grafana-forge doctor' for validation."
  urls
}
down(){ need docker; docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" down; }
status(){ need docker; docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps; }
urls(){
  [[ -f "$ENV_FILE" ]] || { err "No generated stack yet. Run './grafana-forge' first."; exit 1; }
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  printf 'Grafana:    http://localhost:%s\n' "$GRAFANA_PORT"
  printf 'Prometheus: http://localhost:%s\n' "$PROMETHEUS_PORT"
  printf 'Loki:       http://localhost:%s\n' "$LOKI_PORT"
  printf 'Login:      %s / %s\n' "$GRAFANA_ADMIN_USER" "$GRAFANA_ADMIN_PASSWORD"
}
doctor(){
  local failed=0
  printf 'Grafana Forge Doctor %s\n' "$VERSION"
  printf '%s\n' '────────────────────────────────────────'
  for c in docker curl awk grep; do if command -v "$c" >/dev/null 2>&1; then printf '[PASS] %-28s\n' "$c available"; else printf '[FAIL] %-28s\n' "$c missing"; failed=1; fi; done
  docker compose version >/dev/null 2>&1 && printf '[PASS] %-28s\n' 'Docker Compose' || { printf '[FAIL] %-28s\n' 'Docker Compose'; failed=1; }
  [[ -f "$COMPOSE_FILE" && -f "$ENV_FILE" ]] || { printf '[FAIL] %-28s\n' 'generated stack'; return 1; }
  compose_config && printf '[PASS] %-28s\n' 'Compose syntax' || { printf '[FAIL] %-28s\n' 'Compose syntax'; failed=1; }
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  wait_http "http://127.0.0.1:${PROMETHEUS_PORT}/-/ready" 3 && printf '[PASS] %-28s\n' 'Prometheus API' || { printf '[FAIL] %-28s\n' 'Prometheus API'; failed=1; }
  wait_http "http://127.0.0.1:${GRAFANA_PORT}/api/health" 3 && printf '[PASS] %-28s\n' 'Grafana API' || { printf '[FAIL] %-28s\n' 'Grafana API'; failed=1; }
  check_grafana_dashboards || failed=1
  check_targets && printf '[PASS] %-28s\n' 'Prometheus targets' || { printf '[FAIL] %-28s\n' 'Prometheus targets'; failed=1; }
  grep -q 'name: Prometheus' "$ROOT/provisioning/datasources/datasources.yml" && printf '[PASS] %-28s\n' 'Datasource provisioning' || { printf '[FAIL] %-28s\n' 'Datasource provisioning'; failed=1; }
  find "$ROOT/dashboards" -name '*.json' -print -quit | grep -q . && printf '[PASS] %-28s\n' 'Dashboard provisioning' || { printf '[FAIL] %-28s\n' 'Dashboard provisioning'; failed=1; }
  grep -q 'ForgeHighCPU' "$ROOT/alerts/forge.yml" && printf '[PASS] %-28s\n' 'Alert rules' || { printf '[FAIL] %-28s\n' 'Alert rules'; failed=1; }
  printf '%s\n' '────────────────────────────────────────'
  (( failed == 0 )) && printf 'RESULT: HEALTHY\n' || { printf 'RESULT: UNHEALTHY\n'; return 1; }
}
debug(){
  if [[ "${1:-}" == "--json" ]]; then
    printf '{"version":"%s","root":"%s","compose":"%s","env":"%s"}\n' "$VERSION" "$ROOT" "$COMPOSE_FILE" "$ENV_FILE"; return 0
  fi
  printf 'Grafana Forge Debug %s\n' "$VERSION"
  printf '%s\n' '────────────────────────────────────────'
  printf 'OS:       %s\n' "$(uname -srm)"
  printf 'Docker:   %s\n' "$(docker --version 2>/dev/null || echo unavailable)"
  printf 'Compose:  %s\n' "$(docker compose version 2>/dev/null || echo unavailable)"
  printf 'Root:     %s\n' "$ROOT"
  printf '\nGenerated services:\n'
  [[ -f "$COMPOSE_FILE" ]] && grep '^  [a-zA-Z].*:$' "$COMPOSE_FILE" | sed 's/://' | sed 's/^/  /' || echo '  compose.yml missing'
  printf '\nGenerated dashboards:\n'; find "$ROOT/dashboards" -maxdepth 1 -name '*.json' -printf '  %f\n' 2>/dev/null | sort || true
  printf '\nGenerated provisioning:\n'; find "$ROOT/provisioning" -type f -printf '  %P\n' 2>/dev/null | sort || true
  printf '\nRun ./grafana-forge doctor for pass/fail validation.\n'
}
config(){
  [[ -f "$ENV_FILE" ]] || { err "No generated configuration."; exit 1; }
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  printf 'Grafana Forge Configuration\n\n'
  printf 'Profiles: '; cat "$STATE_DIR/profiles" 2>/dev/null || echo unknown
  printf 'Grafana plugins: %s\n' "${FORGE_GRAFANA_PLUGINS:-}"
  printf 'Metrics retention: %s\n' "$FORGE_RETENTION"
  printf 'Log retention: %s\n' "$FORGE_LOG_RETENTION"
  printf '\nFiles:\n'; find "$ROOT" -maxdepth 3 -type f \( -name '*.yml' -o -name '*.yaml' -o -name '*.json' -o -name '*.alloy' \) -printf '  %P\n' 2>/dev/null | sort
}
repair(){
  need docker
  local service="${1:-}"
  if [[ -n "$service" ]]; then docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d --force-recreate "$service"; else docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" up -d --force-recreate; fi
  doctor
}
logs_cmd(){ need docker; docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" logs -f "${1:-}"; }
backup(){
  mkdir -p "$STATE_DIR"
  local out="$STATE_DIR/grafana-forge-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -czf "$out" --exclude='.state/*.tar.gz' --exclude='.git' -- .env compose.yml prometheus.yml loki-config.yml config dashboards provisioning alerts 2>/dev/null || true
  printf '%s\n' "$out"
}
fix_cmd(){
  need docker
  docker compose version >/dev/null 2>&1 || {
    err "Docker Compose v2 is required."
    return 1
  }

  local hard=false

  if [[ "${2:-}" == "--hard" ]]; then
    hard=true
  fi

  log "Grafana Forge AutoFix"

  if "$hard"; then
    printf '%s\n' '────────────────────────────────────────'
    log "HARD RESET REQUESTED"
    log "Stopping and removing the existing stack..."

    if [[ -f "$COMPOSE_FILE" && -f "$ENV_FILE" ]]; then
      docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" \
        down -v --remove-orphans 2>/dev/null || true
    fi

    rm -rf \
      "$ENV_FILE" \
      "$COMPOSE_FILE" \
      "$ROOT/prometheus.yml" \
      "$ROOT/loki-config.yml" \
      "$ROOT/config" \
      "$ROOT/alerts" \
      "$ROOT/dashboards" \
      "$ROOT/provisioning"

    mkdir -p "$STATE_DIR"

    log "Detecting profiles..."
    parse_profiles
  else
    printf '%s\n' '────────────────────────────────────────'
    log "Regenerating configuration..."

    if [[ -f "$STATE_DIR/profiles" ]]; then
      # shellcheck disable=SC2207
      PROFILES=($(cat "$STATE_DIR/profiles"))
    else
      parse_profiles
    fi
  fi

  render

  printf '%s\n' '────────────────────────────────────────'
  log "Validating Compose configuration..."

  if ! compose_config; then
    err "Generated Compose configuration is invalid."
    debug
    return 1
  fi

  printf '%s\n' '────────────────────────────────────────'
  log "Pulling required images..."

  docker compose \
    -f "$COMPOSE_FILE" \
    --env-file "$ENV_FILE" \
    pull

  printf '%s\n' '────────────────────────────────────────'
  log "Starting/recreating services..."

  docker compose \
    -f "$COMPOSE_FILE" \
    --env-file "$ENV_FILE" \
    up -d --force-recreate --remove-orphans

  printf '%s\n' '────────────────────────────────────────'
  log "Waiting for services..."

  if wait_http "http://127.0.0.1:${PROMETHEUS_PORT}/-/ready" 30; then
    printf '[PASS] %-28s\n' "Prometheus ready"
  else
    printf '[FAIL] %-28s\n' "Prometheus ready"
  fi

  if wait_http "http://127.0.0.1:${GRAFANA_PORT}/api/health" 30; then
    printf '[PASS] %-28s\n' "Grafana ready"
  else
    printf '[FAIL] %-28s\n' "Grafana ready"
  fi

  if has_profile logs; then
    if wait_http "http://127.0.0.1:${LOKI_PORT}/ready" 30; then
      printf '[PASS] %-28s\n' "Loki ready"
    else
      printf '[FAIL] %-28s\n' "Loki ready"
    fi
  fi

  printf '%s\n' '────────────────────────────────────────'
  log "Running final diagnostics..."

  if doctor; then
    printf '%s\n' '────────────────────────────────────────'
    log "Grafana Forge is HEALTHY."
    urls
    return 0
  fi

  printf '%s\n' '────────────────────────────────────────'
  err "AutoFix could not make the stack healthy."

  printf '\n'
  printf 'Diagnostic commands:\n'
  printf '  ./grafana-forge doctor\n'
  printf '  ./grafana-forge debug\n'
  printf '  ./grafana-forge status\n'
  printf '  ./grafana-forge logs <service>\n'

  return 1
}
reset(){
  need docker
  if [[ -f "$COMPOSE_FILE" && -f "$ENV_FILE" ]]; then docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" down -v --remove-orphans 2>/dev/null || true; fi
  rm -rf "$ENV_FILE" "$COMPOSE_FILE" "$ROOT/prometheus.yml" "$ROOT/loki-config.yml" "$ROOT/config" "$ROOT/alerts" "$ROOT/dashboards" "$ROOT/provisioning" "$ROOT/alerts" "$STATE_DIR"
  mkdir -p "$STATE_DIR"
  log 'Generated state and volumes removed.'
}

case "${1:-}" in
  "")
    up
    ;;

  up)
    shift
    up "$@"
    ;;

  status)
    status
    ;;

  urls)
    urls
    ;;

  doctor)
    doctor
    ;;

  debug)
    shift
    debug "${1:-}"
    ;;

  config)
    config
    ;;

  fix)
    fix_cmd "$@"
    ;;

  repair)
    repair "${2:-}"
    ;;

  logs)
    logs_cmd "${2:-}"
    ;;

  backup)
    backup
    ;;

  down)
    down
    ;;

  reset)
    reset
    ;;

  *)
    usage
    exit 1
    ;;
esac